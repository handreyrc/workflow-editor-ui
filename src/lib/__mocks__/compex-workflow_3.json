{
  "id": "github-monitor",
  "specVersion": "0.8.0",
  "version": "0.0.2",
  "name": "GitHub Issue Notification Workflow",
  "description": "Lists open issues from a GitHub repository, sends Slack notifications, and takes further actions based on issue severity.",
  "annotations": ["product management", "productivity"],
  "extensions": [
    {
      "extensionid": "workflow-output-schema",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "AnythingObject",
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "errors": [
    { "name": "GitHubError", "code": "GitHubError" },
    { "name": "SlackError", "code": "SlackError" }
  ],
  "start": "Initialize Workflow Data",
  "functions": [
    { "name": "logInfo", "type": "custom", "operation": "sysout:INFO" },
    { "name": "listRepoIssues", "operation": "specs/github.yml#listRepoIssues" },
    { "name": "sendSlackMessage", "operation": "specs/slack.yml#postMessage" }
  ],
  "states": [
    {
      "name": "Initialize Workflow Data",
      "type": "inject",
      "data": {
        "issueCount": 0,
        "criticalIssues": [],
        "nonCriticalIssues": []
      },
      "transition": "List Open Github Issues"
    },
    {
      "name": "List Open Github Issues",
      "type": "operation",
      "timeouts": { "stateExecTimeout": "PT30S" },
      "actions": [
        {
          "name": "logStart",
          "functionRef": {
            "refName": "logInfo",
            "arguments": {
              "message": "${ \"Starting workflow for owner: \" + .owner + \", repo: \" + .repo + \", channel: \" + .channel }"
            }
          }
        },
        {
          "name": "listIssuesAction",
          "functionRef": {
            "refName": "listRepoIssues",
            "arguments": {
              "owner": "${ .owner }",
              "repo": "${ .repo }",
              "state": "open"
            }
          },
          "actionDataFilter": { "toStateData": ".issues" }
        }
      ],
      "onErrors": [
        {
          "errorRef": "GitHubError",
          "transition": "HandleGitHubError"
        }
      ],
      "transition": "Check Issue Severity and Notify"
    },
    {
      "name": "Check Issue Severity and Notify",
      "type": "parallel",
      "branches": [
        {
          "name": "Process Critical Issues",
          "actions": [
            {
              "name": "FilterCriticalIssues",
              "functionRef": {
                "refName": "logInfo",
                "arguments": {
                  "message": "${ \"Filtering critical issues...\" }"
                }
              },
              "actionDataFilter": {
                "fromStateData": "${ .issues | map(select(.labels[].name | contains(\"critical\"))) }",
                "toStateData": ".criticalIssues"
              }
            },
            {
              "name": "SendCriticalIssueMessages",
              "functionRef": {
                "refName": "sendSlackMessage",
                "arguments": {
                  "channel": "${ .channel }",
                  "text": "${ \"Critical Issue Alert: \" + (.criticalIssues | map(.title) | join(\", \")) }"
                }
              }
            }
          ]
        },
        {
          "name": "Process Non-Critical Issues",
          "actions": [
            {
              "name": "FilterNonCriticalIssues",
              "functionRef": {
                "refName": "logInfo",
                "arguments": {
                  "message": "${ \"Filtering non-critical issues...\" }"
                }
              },
              "actionDataFilter": {
                "fromStateData": "${ .issues | map(select(.labels[].name | contains(\"critical\") | not)) }",
                "toStateData": ".nonCriticalIssues"
              }
            },
            {
              "name": "SendNonCriticalIssueMessages",
              "functionRef": {
                "refName": "sendSlackMessage",
                "arguments": {
                  "channel": "${ .channel }",
                  "text": "${ \"Non-Critical Issues: \" + (.nonCriticalIssues | map(.title) | join(\", \")) }"
                }
              }
            }
          ]
        }
      ],
      "completionType": "allOf",
      "onErrors": [
        {
          "errorRef": "SlackError",
          "transition": "HandleSlackError"
        }
      ],
      "transition": "Send Summary Message On Slack"
    },
    {
      "name": "Send Summary Message On Slack",
      "type": "operation",
      "timeouts": { "stateExecTimeout": "PT30S" },
      "actions": [
        {
          "name": "logSummary",
          "functionRef": {
            "refName": "logInfo",
            "arguments": {
              "message": "${ \"Sending summary message to Slack.\" }"
            }
          }
        },
        {
          "name": "sendSummaryMessage",
          "functionRef": {
            "refName": "sendSlackMessage",
            "arguments": {
              "channel": "${ .channel }",
              "text": "${ \"Total issues: \" + (.issues | length) + \"\\nCritical: \" + (.criticalIssues | length) + \"\\nNon-Critical: \" + (.nonCriticalIssues | length) }"
            }
          }
        }
      ],
      "onErrors": [
        {
          "errorRef": "SlackError",
          "transition": "HandleSlackError"
        }
      ],
      "transition": "Finalize Workflow"
    },
    {
      "name": "Finalize Workflow",
      "type": "inject",
      "data": {
        "workflowStatus": "Completed"
      },
      "end": true
    },
    {
      "name": "HandleGitHubError",
      "type": "operation",
      "timeouts": {
        "stateExecTimeout": "PT10S"
      },
      "actions": [
        {
          "name": "logGitHubError",
          "functionRef": {
            "refName": "logInfo",
            "arguments": {
              "message": "${ \"GitHub API error occurred. Please verify repository details.\" }"
            }
          }
        },
        {
          "name": "notifyGitHubError",
          "functionRef": {
            "refName": "sendSlackMessage",
            "arguments": {
              "channel": "${ .channel }",
              "text": "${ \"GitHub API error occurred. Please verify repository details.\" }"
            }
          }
        }
      ],
      "end": true
    },
    {
      "name": "HandleSlackError",
      "type": "operation",
      "timeouts": {
        "stateExecTimeout": "PT10S"
      },
      "actions": [
        {
          "name": "logSlackError",
          "functionRef": {
            "refName": "logInfo",
            "arguments": {
              "message": "${ \"Slack notification error occurred. Check Slack configuration.\" }"
            }
          }
        },
        {
          "name": "notifySlackError",
          "functionRef": {
            "refName": "sendSlackMessage",
            "arguments": {
              "channel": "${ .channel }",
              "text": "${ \"Slack notification error occurred. Check Slack configuration.\" }"
            }
          }
        }
      ],
      "end": true
    }
  ]
}
